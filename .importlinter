# AI-PROJECT-MANAGER-COMPOSITION-V2
#
# Derived from the actual import graph in src/domoai. These contracts are
# authoritative: a new reverse dependency must fail validation, not become a
# silent exception.

[importlinter]
root_package = domoai

# Whole-tree safety net: no two siblings may depend on each other in both
# directions, no matter what new subpackage gets added later.
[importlinter:contract:acyclic-siblings]
name = Sibling packages must remain acyclic
type = acyclic_siblings
ancestors = domoai
depth = 10

# domoai.domain is the innermost core: pydantic models, error types, and
# domain rules. Nothing in domain may reach out to any other subpackage.
[importlinter:contract:domain-independence]
name = domain must not depend on any other domoai subpackage
type = independence
modules =
    domoai.domain

# Layering, high (entrypoint/composition) to low (core). Each layer may import
# any layer below it but never one above:
#   mcp / lab / hil - process entrypoints (MCP servers, lab CLI, HIL runner)
#   application  - use-case orchestration and composition root
#   skills       - agent-facing workflow layer (imports optimizer)
#   adapters     - protocol adapters (home_assistant, knx, matter, modbus,
#                  zigbee2mqtt) + adapter SDK/fixtures
#   optimizer    - CP-SAT / energy optimization
#   persistence  - sqlite repositories
#   config       - policy/settings loaders
#   runtime      - low-level clock, execution_context, ports, events,
#                  state_store, registry, approval_store and risk classifier
#   domain       - core models
[importlinter:contract:layers]
name = Composition-root layers must depend only downward
type = layers
layers =
    domoai.mcp
    domoai.lab
    domoai.hil
    domoai.application
    domoai.skills
    domoai.adapters
    domoai.optimizer
    domoai.persistence
    domoai.config
    domoai.runtime
    domoai.domain

# Protocol adapters must stay mutually independent: knx must not reach into
# modbus, home_assistant must not reach into zigbee2mqtt, etc. Each adapter
# only depends on domoai.adapters.sdk / domoai.adapters.fixtures, domain and
# runtime today.
[importlinter:contract:adapter-independence]
name = Protocol adapters must not depend on each other
type = independence
modules =
    domoai.adapters.home_assistant
    domoai.adapters.knx
    domoai.adapters.matter
    domoai.adapters.modbus
    domoai.adapters.zigbee2mqtt
