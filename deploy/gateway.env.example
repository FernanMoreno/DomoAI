# Copy this file to deploy/gateway.env and fill in secrets locally.
DOMOAI_MCP_HOST=0.0.0.0
DOMOAI_MCP_PORT=8124
DOMOAI_MCP_PATH=/mcp
# Use the public HTTPS URL served by the reverse proxy.
DOMOAI_MCP_PUBLIC_URL=https://mcp.example.test
DOMOAI_CADDY_HOSTNAME=mcp.example.test
# The proxy is the only default host edge. Restrict these to localhost for a
# single-host deployment, or expose the edge on a private network with a
# firewall policy.
# DOMOAI_PROXY_HTTP_BIND=0.0.0.0
# DOMOAI_PROXY_HTTPS_BIND=0.0.0.0
# Change only when another local lab owns the defaults; the bind stays
# loopback-only.
# DOMOAI_MQTT_HOST_PORT=1884
# DOMOAI_HOME_ASSISTANT_HOST_PORT=8125
DOMOAI_MCP_CLIENT_TOKEN_FILE=/run/secrets/mcp-clients.json
DOMOAI_MCP_DEPLOYMENT_ID=home-main
# JSON POST responses are the default bounded MCP mode. Enable only after
# separately qualifying server-initiated SSE lifecycle for this deployment.
DOMOAI_MCP_JSON_RESPONSE=true
DOMOAI_MCP_SERVER_SENT_EVENTS=false
DOMOAI_DATABASE_PATH=/app/data/domoai.sqlite3
DOMOAI_AUDIT_DATABASE_PATH=/app/data/domoai-audit.sqlite3
DOMOAI_COMMISSIONING_MANIFEST_PATH=/app/data/commissioning-manifest.json

# Home Assistant and MQTT are service names on this Compose network.
DOMOAI_HOME_ASSISTANT_URL=http://homeassistant:8123
DOMOAI_HOME_ASSISTANT_TOKEN=replace-with-a-local-long-lived-token
DOMOAI_ZIGBEE2MQTT_URL=mqtt://mqtt:1883

# KNX Virtual/ETS remains on Windows. The WSL knxd bridge is the DomoAI
# endpoint and must be reachable from the container; 3671 stays upstream.
DOMOAI_KNX_GATEWAY_HOST=host.docker.internal
DOMOAI_KNX_GATEWAY_PORT=3672
DOMOAI_KNX_CONFIG_PATH=/app/config/knx-config.json
DOMOAI_KNX_GATEWAY_ROUTE_BACK=0

# Set these host-side Compose interpolation variables when using KNX.
# DOMOAI_MCP_CLIENT_TOKEN_FILE_HOST=./clients.json
# DOMOAI_KNX_CONFIG_PATH_HOST=./knx-config.json
