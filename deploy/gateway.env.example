# Copy this file to deploy/gateway.env and fill in secrets locally.
DOMOAI_MCP_HOST=0.0.0.0
DOMOAI_MCP_PORT=8124
DOMOAI_MCP_PATH=/mcp
# Use the public HTTPS URL served by the reverse proxy.
DOMOAI_MCP_PUBLIC_URL=https://mcp.example.test
DOMOAI_CADDY_HOSTNAME=mcp.example.test
# The proxy is the only default host edge and binds to localhost unless the
# operator explicitly selects an external interface and firewall policy.
# DOMOAI_PROXY_HTTP_BIND=192.0.2.10
# DOMOAI_PROXY_HTTPS_BIND=192.0.2.10
# Host-side certificate paths used by Compose; never put private key contents
# in this file or in Git. Relative paths are resolved from deploy/.
DOMOAI_TLS_CERT_FILE_HOST=./tls/fullchain.pem
DOMOAI_TLS_KEY_FILE_HOST=./tls/privkey.pem
# Change only when another local lab owns the defaults; the bind stays
# loopback-only.
# DOMOAI_MQTT_HOST_PORT=1884
# DOMOAI_HOME_ASSISTANT_HOST_PORT=8125
DOMOAI_MCP_CLIENT_TOKEN_FILE=/run/secrets/mcp-clients.json
# Supported authentication profile: server-provisioned static bearer hashes.
# The management plane may act as an OAuth client, but never as an OAuth
# authorization server.
DOMOAI_MCP_DEPLOYMENT_ID=home-main
DOMOAI_MCP_TENANT_ID=tenant-main
DOMOAI_MCP_HOUSEHOLD_ID=home-main
DOMOAI_PRIVACY_RETENTION_DAYS=90
# DOMOAI_BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/domoai-backup.key
# JSON POST responses are the default bounded MCP mode. Enable only after
# separately qualifying server-initiated SSE lifecycle for this deployment.
DOMOAI_MCP_JSON_RESPONSE=true
DOMOAI_MCP_SERVER_SENT_EVENTS=false
# Optional pull endpoint for authenticated Prometheus-compatible scraping.
DOMOAI_MCP_METRICS_ENABLED=false
DOMOAI_DATABASE_PATH=/app/data/domoai.sqlite3
DOMOAI_AUDIT_DATABASE_PATH=/app/data/domoai-audit.sqlite3
DOMOAI_COMMISSIONING_MANIFEST_PATH=/app/data/commissioning-manifest.json

# Multi-host is fail-closed and disabled by default. Do not enable it from
# this single-host example until the external etcd/PostgreSQL runbook and
# fencing-aware physical gateway have passed qualification.
# DOMOAI_MULTI_HOST_ENABLED=false
# DOMOAI_MULTI_HOST_PRODUCTION_ENABLED=false
# DOMOAI_MULTI_HOST_QUALIFICATION_EVIDENCE_PATH=/run/secrets/multihost-qualification.json
# DOMOAI_MULTI_HOST_GATEWAY_IDENTITY=gateway-serial-or-attested-id
# DOMOAI_ACTIVE_ACTIVE_ENABLED=false
# DOMOAI_INSTANCE_ID=home-host-a
# DOMOAI_ETCD_ENDPOINTS=https://etcd-1.internal:2379,https://etcd-2.internal:2379,https://etcd-3.internal:2379
# DOMOAI_ETCD_CA_CERT_PATH=/run/secrets/etcd-ca.pem
# DOMOAI_ETCD_CLIENT_CERT_PATH=/run/secrets/etcd-client.pem
# DOMOAI_ETCD_CLIENT_KEY_PATH=/run/secrets/etcd-client.key
# DOMOAI_POSTGRES_DSN=postgresql://domoai@postgres-primary.internal:5432/domoai
# DOMOAI_POSTGRES_SSLMODE=verify-full
# DOMOAI_POSTGRES_SSLROOTCERT=/run/secrets/postgres-ca.pem
# DOMOAI_POSTGRES_SSLCERT=/run/secrets/postgres-client.pem
# DOMOAI_POSTGRES_SSLKEY=/run/secrets/postgres-client.key

# Home Assistant and MQTT are service names on this Compose network.
DOMOAI_HOME_ASSISTANT_URL=http://homeassistant:8123
DOMOAI_HOME_ASSISTANT_TOKEN=replace-with-a-local-long-lived-token
# Optional external Home Assistant OAuth client configuration. The management
# UI can discover standard OAuth/OIDC metadata from a base URL, so these
# endpoint values are only needed for manual fallback or a non-standard server.
# Client registration still happens in Home Assistant/the external provider.
# Tokens are stored in the encrypted secret store and are never persisted in
# profiles.
# DOMOAI_HOME_ASSISTANT_OAUTH_AUTHORIZATION_URL=https://example.test/authorize
# DOMOAI_HOME_ASSISTANT_OAUTH_TOKEN_URL=https://example.test/token
# DOMOAI_HOME_ASSISTANT_OAUTH_REVOKE_URL=https://example.test/revoke
# DOMOAI_HOME_ASSISTANT_OAUTH_CLIENT_ID=domoai-client
# DOMOAI_HOME_ASSISTANT_OAUTH_REDIRECT_URI=https://mcp.example.test/oauth/callback
# DOMOAI_HOME_ASSISTANT_OAUTH_SCOPES=read config
# Validate local OAuth readiness without contacting Home Assistant:
# uv run domoai-admin oauth preflight --env-file deploy/gateway.env
# A locally valid configuration still needs external application registration
# and exact redirect URI confirmation before production use.
DOMOAI_ZIGBEE2MQTT_URL=mqtt://mqtt:1883
DOMOAI_GENERIC_MQTT_URL=mqtt://mqtt:1883
DOMOAI_GENERIC_MQTT_MAPPING_PATH=/run/config/generic-mqtt.json
# Optional read-only Home Assistant MQTT Discovery source.
# DOMOAI_GENERIC_MQTT_DISCOVERY_URL=mqtt://mqtt:1883
# DOMOAI_GENERIC_MQTT_DISCOVERY_PREFIX=homeassistant

# KNX Virtual/ETS remains on Windows. The WSL knxd bridge is the DomoAI
# endpoint and must be reachable from the container; 3671 stays upstream.
DOMOAI_KNX_GATEWAY_HOST=host.docker.internal
DOMOAI_KNX_GATEWAY_PORT=3672
DOMOAI_KNX_CONFIG_PATH=/app/config/knx-config.json
DOMOAI_KNX_GATEWAY_ROUTE_BACK=0
# Optional KNX Secure defaults. The credential reference points to an
# encrypted FileSecretStore bundle; raw passwords and keys never belong here.
# DOMOAI_KNX_SECURE_MODE=ip_and_data_secure
# DOMOAI_KNX_SECURE_KEYRING_PATH=/run/secrets/house.knxkeys
# DOMOAI_KNX_SECURE_INTERFACE=192.168.1.20
# DOMOAI_KNX_SECURE_USER_ID=7
# DOMOAI_KNX_SECURE_CREDENTIAL_REF=secret:replace-with-opaque-reference

# Set these host-side Compose interpolation variables when using KNX.
# DOMOAI_MCP_CLIENT_TOKEN_FILE_HOST=./clients.json
# DOMOAI_KNX_CONFIG_PATH_HOST=./knx-config.json
