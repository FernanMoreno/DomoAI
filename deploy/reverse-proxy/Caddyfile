# Production edge certificate material is supplied by the operator through
# read-only Compose mounts. The hostname is supplied by DOMOAI_CADDY_HOSTNAME.
{$DOMOAI_CADDY_HOSTNAME} {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    @mcp path /mcp /mcp/*
    handle @mcp {
        reverse_proxy gateway:8124
    }

    @health path /healthz /readyz /metrics
    handle @health {
        reverse_proxy gateway:8124
    }

    # Never turn a future gateway route into an accidental public endpoint.
    handle {
        respond 404
    }
}
