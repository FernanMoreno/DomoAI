# LAB ONLY. Select this file explicitly for an isolated private lab; it is
# never mounted by the production Compose deployment.
{$DOMOAI_CADDY_HOSTNAME} {
    tls internal

    @mcp path /mcp /mcp/*
    handle @mcp {
        reverse_proxy gateway:8124
    }

    @health path /healthz /readyz /metrics
    handle @health {
        reverse_proxy gateway:8124
    }

    # Never turn a future gateway route into an accidental public endpoint.
    handle {
        respond 404
    }
}
