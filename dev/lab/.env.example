# Deterministic local profiles
DOMOAI_ZIGBEE2MQTT_URL=mqtt://127.0.0.1:1883
DOMOAI_ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
DOMOAI_MQTT_TIMEOUT_SECONDS=5

DOMOAI_MODBUS_HOST=127.0.0.1
DOMOAI_MODBUS_PORT=1502
DOMOAI_MODBUS_CONFIG_PATH=dev/lab/configs/modbus.json
DOMOAI_MODBUS_TIMEOUT_SECONDS=5

# Optional authenticated MQTT lab variant; keep values out of this file.
# DOMOAI_MQTT_USERNAME=
# DOMOAI_MQTT_PASSWORD=

# Optional Home Assistant provider/smoke (generate the token in the local UI).
# DOMOAI_HOME_ASSISTANT_URL=http://127.0.0.1:8123
# DOMOAI_HOME_ASSISTANT_TOKEN=
# DOMOAI_HOME_ASSISTANT_PROVIDER=1
# DOMOAI_HOME_ASSISTANT_MAPPING_PATH=config/home-assistant-mappings.json

# Optional manual profiles.
# DOMOAI_MATTER_SERVER_URL=ws://127.0.0.1:5580/ws
# DOMOAI_KNX_GATEWAY_HOST=
# DOMOAI_KNX_CONFIG_PATH=dev/lab/configs/knx-virtual.json
