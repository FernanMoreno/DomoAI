# Deterministic local profiles
DOMOAI_BOOTSTRAP_PROFILE=lab
DOMOAI_BOOTSTRAP_MANIFEST_PATH=data/runtime-bootstrap.json

DOMOAI_ZIGBEE2MQTT_URL=mqtt://127.0.0.1:1883
DOMOAI_ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
DOMOAI_MQTT_TIMEOUT_SECONDS=5

DOMOAI_MODBUS_HOST=127.0.0.1
DOMOAI_MODBUS_PORT=1502
DOMOAI_MODBUS_CONFIG_PATH=dev/lab/configs/modbus.json
DOMOAI_MODBUS_TIMEOUT_SECONDS=5

# Optional authenticated MQTT lab variant; keep values out of this file.
# DOMOAI_MQTT_USERNAME=
# DOMOAI_MQTT_PASSWORD=

# Optional Home Assistant provider/smoke (generate the token in the local UI).
# DOMOAI_HOME_ASSISTANT_URL=http://127.0.0.1:8123
# DOMOAI_HOME_ASSISTANT_TOKEN=
# DOMOAI_HOME_ASSISTANT_PROVIDER=1
# DOMOAI_HOME_ASSISTANT_MAPPING_PATH=dev/lab/configs/home-assistant-lab.json
# With DOMOAI_BOOTSTRAP_PROFILE=lab and an authenticated reachable local HA,
# these two repository-owned lab bindings are selected automatically when
# omitted. Set them explicitly to override the defaults. The HA mapping alone
# never grants battery control authority and no HIL/production qualification
# is implied by this profile.
# DOMOAI_BATTERY_DISPATCH_PROFILE_PATH=dev/lab/configs/dispatchable-battery-lab.json
# DOMOAI_EV_CHARGING_BINDING_PATHS=dev/lab/configs/ev-charging-lab.json

# Optional manual profiles.
# DOMOAI_MATTER_SERVER_URL=ws://127.0.0.1:5580/ws
# KNX Virtual upstream is 172.26.80.1:3671; WSL knxd publishes 3672.
DOMOAI_KNX_KV_HOST=172.26.80.1
# DOMOAI_KNX_GATEWAY_HOST=172.26.93.253
# DOMOAI_KNX_GATEWAY_PORT=3672
# WSL knxd uses explicit endpoints; keep route-back disabled for this lab.
# DOMOAI_KNX_ROUTE_BACK=0
# DOMOAI_KNX_CONFIG_PATH=dev/lab/configs/knx-virtual.json
# The supervised battery facade has its own mapping; do not reuse the runtime
# lighting/sensor mapping above.
# DOMOAI_KNX_BRIDGE_MAPPING_PATH=dev/lab/configs/knx-battery-virtual.json
# DOMOAI_KNX_BRIDGE_READINESS_TIMEOUT_SECONDS=15
# Keep this enabled: ready requires an actual readback through the configured gateway.
# DOMOAI_KNX_BRIDGE_VERIFY_READBACK=1

# Explicitly optional persisted Matter nodes are reported but do not block
# readiness. Never use this to hide a required physical node.
# DOMOAI_MATTER_OPTIONAL_NODE_IDS=<verified-node-id>
# DOMOAI_STATE_REFRESH_INTERVAL_SECONDS=60
# DOMOAI_INVENTORY_REFRESH_INTERVAL_SECONDS=300
