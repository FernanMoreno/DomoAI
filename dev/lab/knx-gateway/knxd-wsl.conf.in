[main]
name=domoai-knx-gateway-wsl
addr=1.0.230
client-addrs=1.0.231:8
connections=server,kv

[server]
server=ets_router
discover=true
debug=debug-server
tunnel=tunnel
interface=0.0.0.0
port=@GATEWAY_PORT@
heartbeat-timeout=90

[tunnel]
filters=log

[debug-server]
name=domoai-knx-gateway-wsl
error-level=6
trace-mask=0x42

[kv]
driver=ipt
ip-address=@KV_HOST@
dest-port=@KV_PORT@
src-port=@UPSTREAM_SOURCE_PORT@
heartbeat-timer=30
heartbeat-retries=3
debug=debug-kv
filters=log,single,retry-filter

[debug-kv]
name=kv
error-level=6
trace-mask=0x42

[retry-filter]
filter=retry
max-retries=0
retry-delay=2
start-timeout=10
may-fail=true
