{
  "$defs": {
    "CapabilityDeclaration": {
      "additionalProperties": false,
      "description": "Semantic capability promised by an adapter package.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CapabilityKind"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "readable": {
          "title": "Readable",
          "type": "boolean"
        },
        "writable": {
          "title": "Writable",
          "type": "boolean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "enum_values": {
          "items": {
            "type": "string"
          },
          "title": "Enum Values",
          "type": "array"
        },
        "commands": {
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "constraints": {
          "additionalProperties": {
            "$ref": "#/$defs/MetadataValue"
          },
          "title": "Constraints",
          "type": "object"
        }
      },
      "required": [
        "name",
        "kind",
        "readable",
        "writable"
      ],
      "title": "CapabilityDeclaration",
      "type": "object"
    },
    "CapabilityKind": {
      "enum": [
        "boolean",
        "integer",
        "number",
        "enum",
        "text",
        "timestamp"
      ],
      "title": "CapabilityKind",
      "type": "string"
    },
    "DeviceType": {
      "enum": [
        "light",
        "switch",
        "cover",
        "climate",
        "sensor",
        "energy",
        "ev_charger",
        "unsupported"
      ],
      "title": "DeviceType",
      "type": "string"
    },
    "MetadataValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Serializable, fail-closed declaration for one adapter package.",
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "adapter_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Adapter Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "contract_version": {
      "const": "v1",
      "default": "v1",
      "title": "Contract Version",
      "type": "string"
    },
    "protocol": {
      "minLength": 1,
      "title": "Protocol",
      "type": "string"
    },
    "package_name": {
      "minLength": 1,
      "title": "Package Name",
      "type": "string"
    },
    "package_version": {
      "minLength": 1,
      "title": "Package Version",
      "type": "string"
    },
    "device_types": {
      "items": {
        "$ref": "#/$defs/DeviceType"
      },
      "minItems": 1,
      "title": "Device Types",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDeclaration"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/MetadataValue"
      },
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "adapter_id",
    "name",
    "protocol",
    "package_name",
    "package_version",
    "device_types",
    "capabilities"
  ],
  "title": "AdapterManifest",
  "type": "object"
}
