{
  "$defs": {
    "BaseLoadPoint": {
      "additionalProperties": false,
      "properties": {
        "slot": {
          "minimum": 0,
          "title": "Slot",
          "type": "integer"
        },
        "power": {
          "minimum": 0,
          "title": "Power",
          "type": "number"
        },
        "unit": {
          "const": "kW",
          "default": "kW",
          "title": "Unit",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceBand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "slot",
        "power"
      ],
      "title": "BaseLoadPoint",
      "type": "object"
    },
    "ConfidenceBand": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "ConfidenceBand",
      "type": "object"
    },
    "Horizon": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "resolution_minutes": {
          "exclusiveMinimum": 0,
          "title": "Resolution Minutes",
          "type": "integer"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "resolution_minutes",
        "timezone"
      ],
      "title": "Horizon",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Residual demand only; controlled loads, storage flows and PV are excluded.",
  "properties": {
    "source_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_revision": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "title": "Source Revision",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "kind": {
      "enum": [
        "declared_reserve",
        "forecast",
        "fixture"
      ],
      "title": "Kind",
      "type": "string"
    },
    "scope": {
      "const": "uncontrolled_demand",
      "title": "Scope",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "horizon": {
      "$ref": "#/$defs/Horizon"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/BaseLoadPoint"
      },
      "title": "Points",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "source_revision",
    "observed_at",
    "kind",
    "scope",
    "horizon",
    "points"
  ],
  "title": "BaseLoadForecastSeries",
  "type": "object"
}
