{
  "$defs": {
    "BatteryProfile": {
      "additionalProperties": false,
      "properties": {
        "capacity_kwh": {
          "exclusiveMinimum": 0,
          "title": "Capacity Kwh",
          "type": "number"
        },
        "initial_soc_kwh": {
          "minimum": 0,
          "title": "Initial Soc Kwh",
          "type": "number"
        },
        "min_soc_kwh": {
          "minimum": 0,
          "title": "Min Soc Kwh",
          "type": "number"
        },
        "max_soc_kwh": {
          "exclusiveMinimum": 0,
          "title": "Max Soc Kwh",
          "type": "number"
        },
        "max_charge_kw": {
          "minimum": 0,
          "title": "Max Charge Kw",
          "type": "number"
        },
        "max_discharge_kw": {
          "minimum": 0,
          "title": "Max Discharge Kw",
          "type": "number"
        },
        "charge_efficiency": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Charge Efficiency",
          "type": "number"
        },
        "discharge_efficiency": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Discharge Efficiency",
          "type": "number"
        },
        "degradation_cost_per_kwh": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degradation Cost Per Kwh"
        }
      },
      "required": [
        "capacity_kwh",
        "initial_soc_kwh",
        "min_soc_kwh",
        "max_soc_kwh",
        "max_charge_kw",
        "max_discharge_kw",
        "charge_efficiency",
        "discharge_efficiency"
      ],
      "title": "BatteryProfile",
      "type": "object"
    },
    "Horizon": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "resolution_minutes": {
          "exclusiveMinimum": 0,
          "title": "Resolution Minutes",
          "type": "integer"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "resolution_minutes",
        "timezone"
      ],
      "title": "Horizon",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Battery state for the horizon; ``None`` means no battery is available.",
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "horizon": {
      "$ref": "#/$defs/Horizon"
    },
    "source_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_revision": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "title": "Source Revision",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "battery": {
      "anyOf": [
        {
          "$ref": "#/$defs/BatteryProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "horizon",
    "source_id",
    "source_revision",
    "observed_at"
  ],
  "title": "BatteryState",
  "type": "object"
}
