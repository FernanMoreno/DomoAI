{
  "$defs": {
    "AuthorityContext": {
      "additionalProperties": false,
      "description": "Non-secret identity and resource scope attached to authority records.\n\nThe defaults are the legacy single-home local runtime. They let v1 rows be\nread during an additive migration while every new authority record still\ncarries an explicit principal and household.",
      "properties": {
        "tenant_id": {
          "default": "default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "household_id": {
          "default": "default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Household Id",
          "type": "string"
        },
        "household_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Household Ids",
          "type": "array"
        },
        "principal_id": {
          "default": "system",
          "maxLength": 200,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/PrincipalRole"
          },
          "maxItems": 5,
          "title": "Roles",
          "type": "array"
        },
        "area_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Area Ids",
          "type": "array"
        },
        "device_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Device Ids",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Capabilities",
          "type": "array"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Operations",
          "type": "array"
        }
      },
      "title": "AuthorityContext",
      "type": "object"
    },
    "BundleCommitStatus": {
      "enum": [
        "committing",
        "completed",
        "scheduled",
        "partially_committed",
        "failed",
        "unknown",
        "missed"
      ],
      "title": "BundleCommitStatus",
      "type": "string"
    },
    "BundleMemberCommit": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "validation_digest": {
          "minLength": 1,
          "title": "Validation Digest",
          "type": "string"
        },
        "execute_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execute At"
        },
        "status": {
          "$ref": "#/$defs/BundleMemberCommitStatus",
          "default": "pending"
        },
        "execution_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheduled": {
          "default": false,
          "title": "Scheduled",
          "type": "boolean"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "predecessor_plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Plan Id"
        },
        "predecessor_plan_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Predecessor Plan Ids",
          "type": "array"
        },
        "predecessor_outcome_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Outcome Digest"
        }
      },
      "required": [
        "plan_id",
        "validation_digest"
      ],
      "title": "BundleMemberCommit",
      "type": "object"
    },
    "BundleMemberCommitStatus": {
      "enum": [
        "pending",
        "executed",
        "scheduled",
        "failed",
        "unknown",
        "missed",
        "dependency_failed"
      ],
      "title": "BundleMemberCommitStatus",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "accepted",
        "rejected",
        "unavailable",
        "failed",
        "cancelled",
        "confirmed_success",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "PrincipalRole": {
      "description": "Role granted by a trusted identity provider for one deployment.",
      "enum": [
        "viewer",
        "planner",
        "operator",
        "owner",
        "service"
      ],
      "title": "PrincipalRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "#/$defs/AuthorityContext"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "bundle_digest": {
      "minLength": 1,
      "title": "Bundle Digest",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/BundleCommitStatus",
      "default": "committing"
    },
    "compensation_policy": {
      "const": "none",
      "default": "none",
      "title": "Compensation Policy",
      "type": "string"
    },
    "approval_reservation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Reservation Id"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/BundleMemberCommit"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Members",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "bundle_digest",
    "scenario_id",
    "members"
  ],
  "title": "BundleCommit",
  "type": "object"
}
