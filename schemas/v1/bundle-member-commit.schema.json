{
  "$defs": {
    "BundleMemberCommitStatus": {
      "enum": [
        "pending",
        "executed",
        "scheduled",
        "failed",
        "unknown",
        "missed",
        "dependency_failed"
      ],
      "title": "BundleMemberCommitStatus",
      "type": "string"
    },
    "ExecutionStatus": {
      "enum": [
        "accepted",
        "rejected",
        "unavailable",
        "failed",
        "cancelled",
        "confirmed_success",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "validation_digest": {
      "minLength": 1,
      "title": "Validation Digest",
      "type": "string"
    },
    "execute_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execute At"
    },
    "status": {
      "$ref": "#/$defs/BundleMemberCommitStatus",
      "default": "pending"
    },
    "execution_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scheduled": {
      "default": false,
      "title": "Scheduled",
      "type": "boolean"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "details": {
      "additionalProperties": true,
      "title": "Details",
      "type": "object"
    },
    "predecessor_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Plan Id"
    },
    "predecessor_plan_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Predecessor Plan Ids",
      "type": "array"
    },
    "predecessor_outcome_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Outcome Digest"
    }
  },
  "required": [
    "plan_id",
    "validation_digest"
  ],
  "title": "BundleMemberCommit",
  "type": "object"
}
