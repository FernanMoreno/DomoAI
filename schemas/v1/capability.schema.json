{
  "$defs": {
    "AvailabilityMode": {
      "description": "Transport mode that may provide a capability observation or command.",
      "enum": [
        "local",
        "remote"
      ],
      "title": "AvailabilityMode",
      "type": "string"
    },
    "CapabilityGuarantees": {
      "additionalProperties": false,
      "description": "Operational guarantees attached to a canonical capability.\n\nDefaults are intentionally legacy-safe.  They describe no additional\nevidence requirement; they do not claim that a physical device was\ncommissioned.",
      "properties": {
        "resolution": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ],
              "gt": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "tolerance": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ],
              "ge": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "expected_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Latency Ms"
        },
        "readback_required": {
          "default": false,
          "title": "Readback Required",
          "type": "boolean"
        },
        "reversible": {
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "confirmation_required": {
          "default": false,
          "title": "Confirmation Required",
          "type": "boolean"
        },
        "availability_modes": {
          "items": {
            "$ref": "#/$defs/AvailabilityMode"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Availability Modes",
          "type": "array"
        },
        "commissioning_required": {
          "$ref": "#/$defs/CommissioningRequirement",
          "default": "not_required"
        }
      },
      "title": "CapabilityGuarantees",
      "type": "object"
    },
    "CapabilityKind": {
      "enum": [
        "boolean",
        "integer",
        "number",
        "enum",
        "text",
        "timestamp"
      ],
      "title": "CapabilityKind",
      "type": "string"
    },
    "CommissioningRequirement": {
      "description": "Trust level required before a capability can be bound for production.",
      "enum": [
        "not_required",
        "recommended",
        "required"
      ],
      "title": "CommissioningRequirement",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CapabilityKind"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "readable": {
      "title": "Readable",
      "type": "boolean"
    },
    "writable": {
      "title": "Writable",
      "type": "boolean"
    },
    "minimum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum"
    },
    "maximum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum"
    },
    "enum_values": {
      "items": {
        "type": "string"
      },
      "title": "Enum Values",
      "type": "array"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "title": "Commands",
      "type": "array"
    },
    "constraints": {
      "additionalProperties": true,
      "title": "Constraints",
      "type": "object"
    },
    "guarantees": {
      "$ref": "#/$defs/CapabilityGuarantees"
    }
  },
  "required": [
    "name",
    "kind",
    "readable",
    "writable"
  ],
  "title": "Capability",
  "type": "object"
}
