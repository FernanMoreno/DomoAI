{
  "$defs": {
    "CommandPostcondition": {
      "additionalProperties": false,
      "description": "Typed observation required before a command is confirmed successful.",
      "properties": {
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "settle_timeout_seconds": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle Timeout Seconds"
        },
        "poll_interval_seconds": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Poll Interval Seconds",
          "type": "number"
        },
        "reconcile_capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Reconcile Capabilities",
          "type": "array"
        }
      },
      "required": [
        "capability",
        "expected"
      ],
      "title": "CommandPostcondition",
      "type": "object"
    },
    "Precondition": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_id",
        "capability",
        "expected"
      ],
      "title": "Precondition",
      "type": "object"
    },
    "RiskClass": {
      "enum": [
        "safe",
        "confirm",
        "restricted"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "device_id": {
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "command": {
      "minLength": 1,
      "title": "Command",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScalarValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "preconditions": {
      "items": {
        "$ref": "#/$defs/Precondition"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "risk_class": {
      "$ref": "#/$defs/RiskClass",
      "default": "safe"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent"
    },
    "postconditions": {
      "items": {
        "$ref": "#/$defs/CommandPostcondition"
      },
      "maxItems": 1,
      "title": "Postconditions",
      "type": "array"
    }
  },
  "required": [
    "id",
    "device_id",
    "command",
    "idempotency_key"
  ],
  "title": "Command",
  "type": "object"
}
