{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "external_id": {
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "source_device_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Device Id"
        },
        "external_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Type"
        },
        "metadata_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Digest"
        }
      },
      "required": [
        "adapter_id",
        "external_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Sanitized projection of a source route; never an execution grant.",
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Provider Id",
      "type": "string"
    },
    "capability": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Capability",
      "type": "string"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "source_device_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Device Id",
      "type": "string"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Commands",
      "type": "array"
    },
    "readable": {
      "title": "Readable",
      "type": "boolean"
    },
    "writable": {
      "title": "Writable",
      "type": "boolean"
    },
    "available": {
      "title": "Available",
      "type": "boolean"
    }
  },
  "required": [
    "provider_id",
    "capability",
    "source_ref",
    "source_device_id",
    "readable",
    "writable",
    "available"
  ],
  "title": "CommissioningRoute",
  "type": "object"
}
