{
  "$defs": {
    "ScalarMap": {
      "additionalProperties": {
        "$ref": "#/$defs/ScalarValue"
      },
      "type": "object"
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Secret-safe description of one concrete connection instance.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "connector_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Connector Id",
      "type": "string"
    },
    "unique_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Unique Id",
      "type": "string"
    },
    "endpoint": {
      "$ref": "#/$defs/ScalarMap"
    },
    "options": {
      "$ref": "#/$defs/ScalarMap"
    },
    "credential_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Ref"
    },
    "mapping_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapping Ref"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "connector_id",
    "unique_id",
    "endpoint",
    "options",
    "created_at",
    "updated_at"
  ],
  "title": "ConnectionProfile",
  "type": "object"
}
