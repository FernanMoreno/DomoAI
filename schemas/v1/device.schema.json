{
  "$defs": {
    "AvailabilityStatus": {
      "enum": [
        "unknown",
        "available",
        "stale",
        "unavailable"
      ],
      "title": "AvailabilityStatus",
      "type": "string"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CapabilityKind"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "readable": {
          "title": "Readable",
          "type": "boolean"
        },
        "writable": {
          "title": "Writable",
          "type": "boolean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "enum_values": {
          "items": {
            "type": "string"
          },
          "title": "Enum Values",
          "type": "array"
        },
        "commands": {
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "constraints": {
          "additionalProperties": true,
          "title": "Constraints",
          "type": "object"
        }
      },
      "required": [
        "name",
        "kind",
        "readable",
        "writable"
      ],
      "title": "Capability",
      "type": "object"
    },
    "CapabilityKind": {
      "enum": [
        "boolean",
        "integer",
        "number",
        "enum",
        "text",
        "timestamp"
      ],
      "title": "CapabilityKind",
      "type": "string"
    },
    "DeviceType": {
      "enum": [
        "light",
        "switch",
        "cover",
        "climate",
        "sensor",
        "energy",
        "ev_charger",
        "unsupported"
      ],
      "title": "DeviceType",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "external_id": {
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "external_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Type"
        },
        "metadata_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Digest"
        }
      },
      "required": [
        "adapter_id",
        "external_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/DeviceType"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "area_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area Id"
    },
    "manufacturer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manufacturer"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "protocol": {
      "minLength": 1,
      "title": "Protocol",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "availability": {
      "$ref": "#/$defs/AvailabilityStatus",
      "default": "unknown"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "last_seen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Seen At"
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "protocol",
    "source_refs"
  ],
  "title": "Device",
  "type": "object"
}
