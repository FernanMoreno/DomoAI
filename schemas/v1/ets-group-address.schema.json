{
  "$defs": {
    "EtsSupportStatus": {
      "enum": [
        "supported",
        "unsupported",
        "ambiguous"
      ],
      "title": "EtsSupportStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "address": {
      "maxLength": 16,
      "minLength": 3,
      "pattern": "^\\d+/\\d+(?:/\\d+)?$",
      "title": "Address",
      "type": "string"
    },
    "dpt": {
      "maxLength": 16,
      "minLength": 3,
      "pattern": "^\\d{1,3}\\.\\d{1,3}$",
      "title": "Dpt",
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "area": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "support": {
      "$ref": "#/$defs/EtsSupportStatus"
    },
    "capability": {
      "anyOf": [
        {
          "enum": [
            "power",
            "brightness",
            "temperature",
            "humidity",
            "occupancy",
            "battery.soc",
            "battery.power",
            "battery.capacity"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability"
    }
  },
  "required": [
    "address",
    "dpt",
    "name",
    "support"
  ],
  "title": "EtsGroupAddress",
  "type": "object"
}
