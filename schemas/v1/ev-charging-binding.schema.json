{
  "additionalProperties": false,
  "description": "Server-owned route and state contract for one EV charger.",
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Provider Id",
      "type": "string"
    },
    "device_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Device Id",
      "type": "string"
    },
    "capability": {
      "minLength": 1,
      "title": "Capability",
      "type": "string"
    },
    "charge_command": {
      "minLength": 1,
      "title": "Charge Command",
      "type": "string"
    },
    "stop_command": {
      "minLength": 1,
      "title": "Stop Command",
      "type": "string"
    },
    "connected_capability": {
      "default": "ev.connected",
      "minLength": 1,
      "title": "Connected Capability",
      "type": "string"
    },
    "soc_capability": {
      "default": "ev.soc",
      "minLength": 1,
      "title": "Soc Capability",
      "type": "string"
    },
    "power_feedback_capability": {
      "default": "ev.power",
      "minLength": 1,
      "title": "Power Feedback Capability",
      "type": "string"
    },
    "departure_capability": {
      "default": "ev.departure_at",
      "minLength": 1,
      "title": "Departure Capability",
      "type": "string"
    },
    "capacity_kwh": {
      "exclusiveMinimum": 0,
      "title": "Capacity Kwh",
      "type": "number"
    },
    "max_charge_kw": {
      "exclusiveMinimum": 0,
      "title": "Max Charge Kw",
      "type": "number"
    },
    "power_unit": {
      "const": "kW",
      "default": "kW",
      "title": "Power Unit",
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "device_id",
    "capability",
    "charge_command",
    "stop_command",
    "capacity_kwh",
    "max_charge_kw"
  ],
  "title": "EVChargingBinding",
  "type": "object"
}
