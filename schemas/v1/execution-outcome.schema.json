{
  "$defs": {
    "AuthorityContext": {
      "additionalProperties": false,
      "description": "Non-secret identity and resource scope attached to authority records.\n\nThe defaults are the legacy single-home local runtime. They let v1 rows be\nread during an additive migration while every new authority record still\ncarries an explicit principal and household.",
      "properties": {
        "tenant_id": {
          "default": "default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "household_id": {
          "default": "default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Household Id",
          "type": "string"
        },
        "household_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Household Ids",
          "type": "array"
        },
        "principal_id": {
          "default": "system",
          "maxLength": 200,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/PrincipalRole"
          },
          "maxItems": 5,
          "title": "Roles",
          "type": "array"
        },
        "area_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Area Ids",
          "type": "array"
        },
        "device_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Device Ids",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Capabilities",
          "type": "array"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Operations",
          "type": "array"
        }
      },
      "title": "AuthorityContext",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "accepted",
        "rejected",
        "unavailable",
        "failed",
        "cancelled",
        "confirmed_success",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "PrincipalRole": {
      "description": "Role granted by a trusted identity provider for one deployment.",
      "enum": [
        "viewer",
        "planner",
        "operator",
        "owner",
        "service"
      ],
      "title": "PrincipalRole",
      "type": "string"
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "SourceCursor": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "stream_id": {
          "minLength": 1,
          "title": "Stream Id",
          "type": "string"
        },
        "epoch": {
          "minLength": 1,
          "title": "Epoch",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "resync": {
          "default": false,
          "title": "Resync",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "stream_id",
        "epoch",
        "sequence"
      ],
      "title": "SourceCursor",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "external_id": {
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "source_device_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Device Id"
        },
        "external_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Type"
        },
        "metadata_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Digest"
        }
      },
      "required": [
        "adapter_id",
        "external_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "StateSnapshot": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityContext"
        },
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StateStatus"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "source_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "device_id",
        "capability",
        "value",
        "observed_at",
        "received_at",
        "status",
        "source_ref"
      ],
      "title": "StateSnapshot",
      "type": "object"
    },
    "StateStatus": {
      "enum": [
        "current",
        "stale",
        "unavailable",
        "invalid"
      ],
      "title": "StateStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "#/$defs/AuthorityContext"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "command_id": {
      "minLength": 1,
      "title": "Command Id",
      "type": "string"
    },
    "execution_attempt_id": {
      "minLength": 1,
      "title": "Execution Attempt Id",
      "type": "string"
    },
    "adapter_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Request Id"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "adapter_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "before_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/StateSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "after_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/StateSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "command_id",
    "execution_attempt_id",
    "status"
  ],
  "title": "ExecutionOutcome",
  "type": "object"
}
