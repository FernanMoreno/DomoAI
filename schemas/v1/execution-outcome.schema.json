{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "accepted",
        "rejected",
        "unavailable",
        "failed",
        "cancelled",
        "confirmed_success",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "external_id": {
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "external_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Type"
        },
        "metadata_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Digest"
        }
      },
      "required": [
        "adapter_id",
        "external_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "StateSnapshot": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StateStatus"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "device_id",
        "capability",
        "value",
        "observed_at",
        "received_at",
        "status",
        "source_ref"
      ],
      "title": "StateSnapshot",
      "type": "object"
    },
    "StateStatus": {
      "enum": [
        "current",
        "stale",
        "unavailable",
        "invalid"
      ],
      "title": "StateStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "command_id": {
      "minLength": 1,
      "title": "Command Id",
      "type": "string"
    },
    "execution_attempt_id": {
      "minLength": 1,
      "title": "Execution Attempt Id",
      "type": "string"
    },
    "adapter_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Request Id"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "adapter_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "before_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/StateSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "after_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/StateSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "command_id",
    "execution_attempt_id",
    "status"
  ],
  "title": "ExecutionOutcome",
  "type": "object"
}
