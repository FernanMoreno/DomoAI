{
  "additionalProperties": false,
  "description": "Identity read from the exercised device or a trusted test authority.\n\nThe CLI labels are intentionally not enough: qualification needs a\nstructured observation tied to the artifact and its observation time.",
  "properties": {
    "hardware_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Hardware Id",
      "type": "string"
    },
    "firmware_version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Firmware Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "adapter_observed",
        "trusted_attestation"
      ],
      "title": "Source",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    }
  },
  "required": [
    "hardware_id",
    "firmware_version",
    "source",
    "observed_at"
  ],
  "title": "HILIdentityObservation",
  "type": "object"
}
