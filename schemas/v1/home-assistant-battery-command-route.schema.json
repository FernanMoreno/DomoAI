{
  "additionalProperties": false,
  "description": "One exact Home Assistant source entity and provider command name.",
  "properties": {
    "entity_id": {
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
      "title": "Entity Id",
      "type": "string"
    },
    "provider_command": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Provider Command",
      "type": "string"
    },
    "service_domain": {
      "anyOf": [
        {
          "const": "number",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Domain"
    },
    "service": {
      "anyOf": [
        {
          "const": "set_value",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service"
    },
    "value_transform": {
      "default": "none",
      "enum": [
        "none",
        "as_is",
        "negate",
        "zero"
      ],
      "title": "Value Transform",
      "type": "string"
    }
  },
  "required": [
    "entity_id",
    "provider_command"
  ],
  "title": "HomeAssistantBatteryCommandRoute",
  "type": "object"
}
