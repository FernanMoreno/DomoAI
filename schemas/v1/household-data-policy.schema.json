{
  "$defs": {
    "AuthorityContext": {
      "additionalProperties": false,
      "description": "Non-secret identity and resource scope attached to authority records.\n\nThe defaults are the legacy single-home local runtime. They let v1 rows be\nread during an additive migration while every new authority record still\ncarries an explicit principal and household.",
      "properties": {
        "tenant_id": {
          "default": "default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "household_id": {
          "default": "default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Household Id",
          "type": "string"
        },
        "household_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Household Ids",
          "type": "array"
        },
        "principal_id": {
          "default": "system",
          "maxLength": 200,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/PrincipalRole"
          },
          "maxItems": 5,
          "title": "Roles",
          "type": "array"
        },
        "area_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Area Ids",
          "type": "array"
        },
        "device_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Device Ids",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Capabilities",
          "type": "array"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Operations",
          "type": "array"
        }
      },
      "title": "AuthorityContext",
      "type": "object"
    },
    "PrincipalRole": {
      "description": "Role granted by a trusted identity provider for one deployment.",
      "enum": [
        "viewer",
        "planner",
        "operator",
        "owner",
        "service"
      ],
      "title": "PrincipalRole",
      "type": "string"
    },
    "PrivacyCategory": {
      "enum": [
        "inventory",
        "state",
        "plans",
        "approvals",
        "bundles",
        "schedules",
        "automations",
        "audit"
      ],
      "title": "PrivacyCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "authority": {
      "$ref": "#/$defs/AuthorityContext"
    },
    "exportable_categories": {
      "items": {
        "$ref": "#/$defs/PrivacyCategory"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Exportable Categories",
      "type": "array"
    },
    "deletable_categories": {
      "items": {
        "$ref": "#/$defs/PrivacyCategory"
      },
      "maxItems": 16,
      "title": "Deletable Categories",
      "type": "array"
    },
    "immutable_categories": {
      "items": {
        "$ref": "#/$defs/PrivacyCategory"
      },
      "maxItems": 16,
      "title": "Immutable Categories",
      "type": "array"
    },
    "retention_days": {
      "maximum": 3650,
      "minimum": 1,
      "title": "Retention Days",
      "type": "integer"
    }
  },
  "required": [
    "authority",
    "exportable_categories",
    "retention_days"
  ],
  "title": "HouseholdDataPolicy",
  "type": "object"
}
