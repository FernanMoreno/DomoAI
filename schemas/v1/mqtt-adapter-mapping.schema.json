{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MQTT Adapter Mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "devices"],
  "properties": {
    "schema_version": {"const": "v1"},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "devices": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "type", "capabilities"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "type": {"type": "string", "minLength": 1, "maxLength": 64},
          "capabilities": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "state_topic"],
              "properties": {
                "name": {"type": "string", "minLength": 1, "maxLength": 96},
                "kind": {"enum": ["boolean", "integer", "number", "enum", "text", "timestamp"], "default": "boolean"},
                "unit": {"type": ["string", "null"], "minLength": 1, "maxLength": 32},
                "minimum": {"type": ["number", "null"]},
                "maximum": {"type": ["number", "null"]},
                "enum_values": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "commands": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
                "state_topic": {"type": "string", "minLength": 1, "maxLength": 256},
                "command_topic": {"type": ["string", "null"], "maxLength": 256},
                "feedback_topic": {"type": ["string", "null"], "maxLength": 256},
                "require_readback": {"type": "boolean", "default": false}
              }
            }
          }
        }
      }
    }
  }
}
