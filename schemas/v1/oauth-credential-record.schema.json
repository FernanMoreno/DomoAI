{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "credential_ref": {
      "pattern": "^(?:secret:[0-9a-fA-F-]{16,128}|env:[A-Za-z_][A-Za-z0-9_]*)$",
      "title": "Credential Ref",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "scopes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Scopes",
      "type": "array"
    },
    "refreshable": {
      "default": false,
      "title": "Refreshable",
      "type": "boolean"
    }
  },
  "required": [
    "provider",
    "credential_ref"
  ],
  "title": "OAuthCredentialRecord",
  "type": "object"
}
