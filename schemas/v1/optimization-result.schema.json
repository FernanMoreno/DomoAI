{
  "$defs": {
    "AlternativeEvidence": {
      "additionalProperties": false,
      "description": "Comparable, bounded evidence for one proposal in a result bundle.",
      "properties": {
        "objective_values": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 32,
          "title": "Objective Values",
          "type": "object"
        },
        "constraint_effects": {
          "additionalProperties": true,
          "maxProperties": 16,
          "title": "Constraint Effects",
          "type": "object"
        },
        "forecast_assumptions": {
          "additionalProperties": true,
          "maxProperties": 16,
          "title": "Forecast Assumptions",
          "type": "object"
        }
      },
      "title": "AlternativeEvidence",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityContext"
        },
        "status": {
          "pattern": "^(approved|denied|expired)$",
          "title": "Status",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "validation_digest": {
          "minLength": 1,
          "title": "Validation Digest",
          "type": "string"
        },
        "scope": {
          "default": "plan",
          "title": "Scope",
          "type": "string"
        },
        "authentication_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authentication Context"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "bundle_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bundle Digest"
        },
        "recurrence_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recurrence Digest"
        },
        "validation_valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Valid Until"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "window_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Digest"
        },
        "schedule_revision": {
          "default": 0,
          "minimum": 0,
          "title": "Schedule Revision",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "validation_digest"
      ],
      "title": "Approval",
      "type": "object"
    },
    "AuthorityContext": {
      "additionalProperties": false,
      "description": "Non-secret identity and resource scope attached to authority records.\n\nThe defaults are the legacy single-home local runtime. They let v1 rows be\nread during an additive migration while every new authority record still\ncarries an explicit principal and household.",
      "properties": {
        "tenant_id": {
          "default": "default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "household_id": {
          "default": "default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Household Id",
          "type": "string"
        },
        "household_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Household Ids",
          "type": "array"
        },
        "principal_id": {
          "default": "system",
          "maxLength": 200,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/PrincipalRole"
          },
          "maxItems": 5,
          "title": "Roles",
          "type": "array"
        },
        "area_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Area Ids",
          "type": "array"
        },
        "device_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Device Ids",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Capabilities",
          "type": "array"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Operations",
          "type": "array"
        }
      },
      "title": "AuthorityContext",
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/Precondition"
          },
          "maxItems": 16,
          "title": "Preconditions",
          "type": "array"
        },
        "risk_class": {
          "$ref": "#/$defs/RiskClass",
          "default": "safe"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent"
        },
        "postconditions": {
          "items": {
            "$ref": "#/$defs/CommandPostcondition"
          },
          "maxItems": 1,
          "title": "Postconditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "device_id",
        "command",
        "idempotency_key"
      ],
      "title": "Command",
      "type": "object"
    },
    "CommandPostcondition": {
      "additionalProperties": false,
      "description": "Typed observation required before a command is confirmed successful.",
      "properties": {
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification": {
          "default": "equals",
          "enum": [
            "equals",
            "toggle_transition",
            "motion_stopped",
            "unconfirmed"
          ],
          "title": "Verification",
          "type": "string"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "settle_timeout_seconds": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle Timeout Seconds"
        },
        "poll_interval_seconds": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Poll Interval Seconds",
          "type": "number"
        },
        "reconcile_capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Reconcile Capabilities",
          "type": "array"
        }
      },
      "required": [
        "capability"
      ],
      "title": "CommandPostcondition",
      "type": "object"
    },
    "DependencyKind": {
      "enum": [
        "assumption",
        "precondition",
        "predecessor_outcome"
      ],
      "title": "DependencyKind",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExecutionOutcome": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityContext"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "command_id": {
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "execution_attempt_id": {
          "minLength": 1,
          "title": "Execution Attempt Id",
          "type": "string"
        },
        "adapter_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Request Id"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "adapter_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "before_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/StateSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "after_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/StateSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "command_id",
        "execution_attempt_id",
        "status"
      ],
      "title": "ExecutionOutcome",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "accepted",
        "rejected",
        "unavailable",
        "failed",
        "cancelled",
        "confirmed_success",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "ExecutionSummary": {
      "additionalProperties": false,
      "properties": {
        "outcomes": {
          "items": {
            "$ref": "#/$defs/ExecutionOutcome"
          },
          "title": "Outcomes",
          "type": "array"
        }
      },
      "title": "ExecutionSummary",
      "type": "object"
    },
    "ExecutionWindow": {
      "additionalProperties": false,
      "description": "Immutable temporal evidence attached to a scheduled physical intent.",
      "properties": {
        "intended_at": {
          "format": "date-time",
          "title": "Intended At",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "not_after": {
          "format": "date-time",
          "title": "Not After",
          "type": "string"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "intended_at",
        "not_before",
        "not_after",
        "timezone"
      ],
      "title": "ExecutionWindow",
      "type": "object"
    },
    "OptimizationStatus": {
      "enum": [
        "optimal",
        "feasible",
        "optimal_hierarchy",
        "feasible_hierarchy",
        "no_action_required",
        "infeasible",
        "invalid",
        "timeout",
        "unknown"
      ],
      "title": "OptimizationStatus",
      "type": "string"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityContext"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "execute_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execute At"
        },
        "execution_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schedule_revision": {
          "default": 0,
          "minimum": 0,
          "title": "Schedule Revision",
          "type": "integer"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/Command"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Commands",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/PlanStatus",
          "default": "draft"
        },
        "definition_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Digest"
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_decisions": {
          "items": {
            "$ref": "#/$defs/PolicyDecision"
          },
          "title": "Policy Decisions",
          "type": "array"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "agent_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Request Id"
        }
      },
      "required": [
        "id",
        "commands"
      ],
      "title": "Plan",
      "type": "object"
    },
    "PlanDependencies": {
      "additionalProperties": false,
      "properties": {
        "inventory_revision": {
          "minLength": 1,
          "title": "Inventory Revision",
          "type": "string"
        },
        "policy_revision": {
          "minLength": 1,
          "title": "Policy Revision",
          "type": "string"
        },
        "state_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "State Versions",
          "type": "object"
        },
        "dependency_kinds": {
          "additionalProperties": {
            "$ref": "#/$defs/DependencyKind"
          },
          "title": "Dependency Kinds",
          "type": "object"
        },
        "capability_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Capability Fingerprints",
          "type": "object"
        }
      },
      "required": [
        "inventory_revision",
        "policy_revision"
      ],
      "title": "PlanDependencies",
      "type": "object"
    },
    "PlanStatus": {
      "enum": [
        "draft",
        "validated",
        "requires_confirmation",
        "ready",
        "approved",
        "executing",
        "completed",
        "partially_failed",
        "failed",
        "cancelled",
        "unknown"
      ],
      "title": "PlanStatus",
      "type": "string"
    },
    "PolicyAction": {
      "enum": [
        "allow",
        "deny",
        "confirm"
      ],
      "title": "PolicyAction",
      "type": "string"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "action": {
          "$ref": "#/$defs/PolicyAction"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "allows_stale": {
          "default": false,
          "title": "Allows Stale",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "Precondition": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "allow_stale": {
          "default": false,
          "title": "Allow Stale",
          "type": "boolean"
        }
      },
      "required": [
        "device_id",
        "capability",
        "expected"
      ],
      "title": "Precondition",
      "type": "object"
    },
    "PrincipalRole": {
      "description": "Role granted by a trusted identity provider for one deployment.",
      "enum": [
        "viewer",
        "planner",
        "operator",
        "owner",
        "service"
      ],
      "title": "PrincipalRole",
      "type": "string"
    },
    "RiskClass": {
      "enum": [
        "safe",
        "confirm",
        "restricted"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "SolvedTier": {
      "additionalProperties": false,
      "description": "One priority tier actually solved for a result.\n\n`priority` is `None` for the implicit soft-constraint-violation tier,\nwhich has no user-declared priority and always precedes every declared\ntier when it is present.",
      "properties": {
        "priority": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Priority"
        },
        "terms": {
          "items": {
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        },
        "achieved_value": {
          "title": "Achieved Value",
          "type": "integer"
        }
      },
      "required": [
        "priority",
        "terms",
        "achieved_value"
      ],
      "title": "SolvedTier",
      "type": "object"
    },
    "SolverEvidence": {
      "additionalProperties": false,
      "description": "Audit trail for one completed solve; see spec 028.",
      "properties": {
        "solver_name": {
          "title": "Solver Name",
          "type": "string"
        },
        "solver_version": {
          "title": "Solver Version",
          "type": "string"
        },
        "num_search_workers": {
          "title": "Num Search Workers",
          "type": "integer"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "wall_time_seconds": {
          "title": "Wall Time Seconds",
          "type": "number"
        },
        "tiers": {
          "items": {
            "$ref": "#/$defs/SolvedTier"
          },
          "title": "Tiers",
          "type": "array"
        },
        "scenario_fingerprint": {
          "title": "Scenario Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "solver_name",
        "solver_version",
        "num_search_workers",
        "random_seed",
        "wall_time_seconds",
        "tiers",
        "scenario_fingerprint"
      ],
      "title": "SolverEvidence",
      "type": "object"
    },
    "SourceCursor": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
