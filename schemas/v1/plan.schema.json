{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "pattern": "^(approved|denied|expired)$",
          "title": "Status",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "validation_digest": {
          "minLength": 1,
          "title": "Validation Digest",
          "type": "string"
        },
        "scope": {
          "default": "plan",
          "title": "Scope",
          "type": "string"
        },
        "authentication_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authentication Context"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        }
      },
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "validation_digest"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/Precondition"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "risk_class": {
          "$ref": "#/$defs/RiskClass",
          "default": "safe"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent"
        },
        "postconditions": {
          "items": {
            "$ref": "#/$defs/CommandPostcondition"
          },
          "maxItems": 1,
          "title": "Postconditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "device_id",
        "command",
        "idempotency_key"
      ],
      "title": "Command",
      "type": "object"
    },
    "CommandPostcondition": {
      "additionalProperties": false,
      "description": "Typed observation required before a command is confirmed successful.",
      "properties": {
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "settle_timeout_seconds": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle Timeout Seconds"
        },
        "poll_interval_seconds": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Poll Interval Seconds",
          "type": "number"
        },
        "reconcile_capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Reconcile Capabilities",
          "type": "array"
        }
      },
      "required": [
        "capability",
        "expected"
      ],
      "title": "CommandPostcondition",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExecutionOutcome": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "command_id": {
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "execution_attempt_id": {
          "minLength": 1,
          "title": "Execution Attempt Id",
          "type": "string"
        },
        "adapter_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Request Id"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "adapter_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "before_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/StateSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "after_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/StateSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "command_id",
        "execution_attempt_id",
        "status"
      ],
      "title": "ExecutionOutcome",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "accepted",
        "rejected",
        "unavailable",
        "failed",
        "cancelled",
        "confirmed_success",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "ExecutionSummary": {
      "additionalProperties": false,
      "properties": {
        "outcomes": {
          "items": {
            "$ref": "#/$defs/ExecutionOutcome"
          },
          "title": "Outcomes",
          "type": "array"
        }
      },
      "title": "ExecutionSummary",
      "type": "object"
    },
    "PlanDependencies": {
      "additionalProperties": false,
      "properties": {
        "inventory_revision": {
          "minLength": 1,
          "title": "Inventory Revision",
          "type": "string"
        },
        "policy_revision": {
          "minLength": 1,
          "title": "Policy Revision",
          "type": "string"
        },
        "state_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "State Versions",
          "type": "object"
        },
        "capability_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Capability Fingerprints",
          "type": "object"
        }
      },
      "required": [
        "inventory_revision",
        "policy_revision"
      ],
      "title": "PlanDependencies",
      "type": "object"
    },
    "PlanStatus": {
      "enum": [
        "draft",
        "validated",
        "requires_confirmation",
        "ready",
        "approved",
        "executing",
        "completed",
        "partially_failed",
        "failed",
        "cancelled",
        "unknown"
      ],
      "title": "PlanStatus",
      "type": "string"
    },
    "PolicyAction": {
      "enum": [
        "allow",
        "deny",
        "confirm"
      ],
      "title": "PolicyAction",
      "type": "string"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "action": {
          "$ref": "#/$defs/PolicyAction"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "Precondition": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_id",
        "capability",
        "expected"
      ],
      "title": "Precondition",
      "type": "object"
    },
    "RiskClass": {
      "enum": [
        "safe",
        "confirm",
        "restricted"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "external_id": {
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "external_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Type"
        },
        "metadata_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Digest"
        }
      },
      "required": [
        "adapter_id",
        "external_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "StateSnapshot": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScalarValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StateStatus"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "device_id",
        "capability",
        "value",
        "observed_at",
        "received_at",
        "status",
        "source_ref"
      ],
      "title": "StateSnapshot",
      "type": "object"
    },
    "StateStatus": {
      "enum": [
        "current",
        "stale",
        "unavailable",
        "invalid"
      ],
      "title": "StateStatus",
      "type": "string"
    },
    "ValidationResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ValidationStatus"
        },
        "validated_at": {
          "format": "date-time",
          "title": "Validated At",
          "type": "string"
        },
        "runtime_revision": {
          "minLength": 1,
          "title": "Runtime Revision",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          },
          "title": "Errors",
          "type": "array"
        },
        "digest": {
          "minLength": 1,
          "title": "Digest",
          "type": "string"
        },
        "dependencies": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanDependencies"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "validated_at",
        "runtime_revision",
        "digest"
      ],
      "title": "ValidationResult",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "valid",
        "invalid",
        "stale",
        "requires_confirmation"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "execute_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execute At"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/Command"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Commands",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/PlanStatus",
      "default": "draft"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_decisions": {
      "items": {
        "$ref": "#/$defs/PolicyDecision"
      },
      "title": "Policy Decisions",
      "type": "array"
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Approval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agent_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Request Id"
    }
  },
  "required": [
    "id",
    "commands"
  ],
  "title": "Plan",
  "type": "object"
}
