{
  "$defs": {
    "Measurement": {
      "additionalProperties": false,
      "description": "Normalized observation with explicit provider provenance.",
      "properties": {
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Provider Id",
          "type": "string"
        },
        "device_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ScalarValue"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/MeasurementQuality",
          "default": "good"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "provider_id",
        "device_id",
        "metric",
        "value",
        "observed_at",
        "received_at",
        "source_ref"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MeasurementQuality": {
      "enum": [
        "good",
        "stale",
        "unavailable",
        "invalid"
      ],
      "title": "MeasurementQuality",
      "type": "string"
    },
    "ProviderDiagnostic": {
      "additionalProperties": false,
      "description": "Stable diagnostic that cannot leak provider exception payloads.",
      "properties": {
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Code",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Provider Id",
          "type": "string"
        },
        "message": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/ScalarValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "provider_id",
        "message"
      ],
      "title": "ProviderDiagnostic",
      "type": "object"
    },
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "external_id": {
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "external_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Type"
        },
        "metadata_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Digest"
        }
      },
      "required": [
        "adapter_id",
        "external_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "measurements": {
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "title": "Measurements",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/ProviderDiagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    }
  },
  "title": "ProviderCollectionResult",
  "type": "object"
}
