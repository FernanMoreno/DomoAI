{
  "$defs": {
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Stable diagnostic that cannot leak provider exception payloads.",
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "code": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Code",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Provider Id",
      "type": "string"
    },
    "message": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "details": {
      "additionalProperties": {
        "$ref": "#/$defs/ScalarValue"
      },
      "title": "Details",
      "type": "object"
    }
  },
  "required": [
    "code",
    "provider_id",
    "message"
  ],
  "title": "ProviderDiagnostic",
  "type": "object"
}
