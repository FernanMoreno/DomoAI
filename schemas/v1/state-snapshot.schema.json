{
  "$defs": {
    "ScalarValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "external_id": {
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "source_device_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Device Id"
        },
        "external_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Type"
        },
        "metadata_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Digest"
        }
      },
      "required": [
        "adapter_id",
        "external_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "StateStatus": {
      "enum": [
        "current",
        "stale",
        "unavailable",
        "invalid"
      ],
      "title": "StateStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "capability": {
      "minLength": 1,
      "title": "Capability",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScalarValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StateStatus"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceRef"
    }
  },
  "required": [
    "device_id",
    "capability",
    "value",
    "observed_at",
    "received_at",
    "status",
    "source_ref"
  ],
  "title": "StateSnapshot",
  "type": "object"
}
